{
  "name": "pagio",
  "version": "0.1.0",
  "description": "Pagio: просмотрщик PDF для работы с документами — непрерывная лента, поиск, печать, показ",
  "main": "src/main/main.js",
  "author": {
    "name": "Ilya Pautov",
    "email": "djdrise@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "sample": "node scripts/make-sample.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.pautov.pagio",
    "productName": "Pagio",
    "files": [
      "assets/**/*",
      "!assets/logo.html",
      "src/**/*",
      "scripts/start.js",
      "node_modules/pdfjs-dist/legacy/build/pdf.mjs",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*",
      "node_modules/pdfjs-dist/iccs/**/*",
      "node_modules/pdfjs-dist/package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "Pagio — PDF reader with continuous scrolling, search, printing and slideshow",
      "description": "Pagio: PDF reader for office use — continuous scrolling, text search, printing, outline, thumbnails and full-screen slideshow",
      "icon": "build/icons"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Pagio.pdf",
        "description": "Документ PDF",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "icon": "build/icon-file"
      }
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "nsis": {
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
